{
  "name": "portfolio-3d",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --log-level warn",
    "format:check": "prettier --check . --log-level warn",
    "styles": "node scripts/check-styles.mjs",
    "knip": "knip",
    "dup": "jscpd --silent || jscpd",
    "shot": "node scripts/screenshot.mjs",
    "paths": "node scripts/paths.mjs",
    "check": "npm run -s format:check && npm run -s lint && npm run -s typecheck && npm run -s styles && npm run -s knip && npm run -s dup",
    "fix": "prettier --write . --log-level warn && eslint . --fix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@headlessui/react": "^2.2.10",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "next": "16.4.5",
    "postprocessing": "^6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "jscpd": "^5.4.2",
    "knip": "^5.88.1",
    "lefthook": "^2.2.2",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
